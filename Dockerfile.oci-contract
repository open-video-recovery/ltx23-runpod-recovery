# OCI contract image. Fake model chunks are placed in FOUR distinct image
# layers and reconstructed WITHOUT downloading from Hugging Face or Docker Hub.
# This is NOT a runnable LTX video endpoint.
FROM python:3.12-slim-bookworm
LABEL org.opencontainers.image.source="https://github.com/open-video-recovery/ltx23-runpod-recovery"
LABEL org.opencontainers.image.description="OCI offline embedded-model contract test (fake weights only)"
WORKDIR /opt/recovery
COPY scripts/model_chunks.py /opt/recovery/scripts/model_chunks.py
COPY scripts/check_public_release.py /opt/recovery/scripts/check_public_release.py
COPY legal/public-ghcr-release-gates.json /opt/recovery/legal/public-ghcr-release-gates.json
COPY third_party_licenses/ /opt/recovery/third_party_licenses/
RUN python /opt/recovery/scripts/check_public_release.py --mode fixture
COPY scripts/verify_legal_snapshot.py /opt/recovery/scripts/verify_legal_snapshot.py
COPY legal-snapshot/ /opt/recovery/official_legal/
RUN python /opt/recovery/scripts/verify_legal_snapshot.py --root /opt/recovery/official_legal/
COPY contract-fixture/chunks.json /opt/recovery/parts/chunks.json
COPY contract-fixture/part-0000.bin /opt/recovery/parts/part-0000.bin
COPY contract-fixture/part-0001.bin /opt/recovery/parts/part-0001.bin
COPY contract-fixture/part-0002.bin /opt/recovery/parts/part-0002.bin
COPY contract-fixture/part-0003.bin /opt/recovery/parts/part-0003.bin
RUN mkdir -p /opt/recovery/models && chmod 777 /opt/recovery/models
USER 65532:65532
CMD ["python", "scripts/model_chunks.py", "assemble", "--manifest", "/opt/recovery/parts/chunks.json", "--output", "/opt/recovery/models/fake-weights.safetensors"]
