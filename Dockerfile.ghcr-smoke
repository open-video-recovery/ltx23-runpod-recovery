# Tiny diagnostics-only image. No RirukaChan image, no model weights.
# This is NOT a working LTX 2.3 image-to-video engine.
FROM python:3.12-slim-bookworm
LABEL org.opencontainers.image.source="https://github.com/open-video-recovery/ltx23-runpod-recovery"
LABEL org.opencontainers.image.description="LTX 2.3 recovery kit - diagnostics only; NO VIDEO GENERATION"
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
RUN python -m pip install --disable-pip-version-check "runpod==1.8.1"
COPY runtime/ghcr_smoke.py /app/ghcr_smoke.py
USER 65532:65532
CMD ["python", "/app/ghcr_smoke.py"]
